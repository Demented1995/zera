generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(MANAGER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  materialPriceChanges    MaterialPriceHistory[]
  pricingSettingsChanges  PricingSettingsHistory[]
  configurationsCreated   SavedConfiguration[]   @relation("ConfigCreatedBy")
  configurationsUpdated   SavedConfiguration[]   @relation("ConfigUpdatedBy")
  offersCreated           CustomerOffer[]        @relation("OfferCreatedBy")
  offersUpdated           CustomerOffer[]        @relation("OfferUpdatedBy")
  offerRevisionsIssued    OfferRevision[]        @relation("RevisionIssuedBy")
  mirrorModelsCreated     MirrorModel[]          @relation("MirrorModelCreatedBy")
  mirrorModelsUpdated     MirrorModel[]          @relation("MirrorModelUpdatedBy")
  mirrorCategoriesCreated MirrorModelCategory[]  @relation("MirrorCategoryCreatedBy")
  mirrorImagesUploaded    MirrorModelImage[]     @relation("MirrorImageUploadedBy")
  customersCreated        Customer[]             @relation("CustomerCreatedBy")
  customersUpdated        Customer[]             @relation("CustomerUpdatedBy")
  ordersPlaced            CustomerOrder[]        @relation("OrderPlacedBy")
  orderStatusChanges      OrderStatusEvent[]     @relation("OrderStatusChangedBy")
}

enum ConfigStatus {
  DRAFT
  COMPLETE
  INCOMPLETE
}

enum MirrorImageKind {
  SECONDARY
  DETAIL
  AMBIENT
}

enum OfferStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
}

/// Saved professional configurator mirror configuration (structured JSON + denormalized list fields).
model SavedConfiguration {
  id               String       @id @default(cuid())
  /// Human-readable unique code, e.g. CFG-2026-0001
  code             String       @unique
  name             String
  status           ConfigStatus @default(DRAFT)
  /// Full ConfiguratorState (shape, LED, processing, commercial, notes).
  configJson       Json
  /// Last calculation result from the central engine (may be incomplete).
  calculationJson  Json?
  shapeId          String
  shapeLabel       String
  widthMm          Decimal      @db.Decimal(12, 2)
  heightMm         Decimal      @db.Decimal(12, 2)
  glassTypeId      String
  sinecost         Decimal?     @db.Decimal(12, 2)
  wholesalePrice   Decimal?     @db.Decimal(12, 2)
  retailPrice      Decimal?     @db.Decimal(12, 2)
  internalNotes    String?
  createdById      String
  createdBy        User         @relation("ConfigCreatedBy", fields: [createdById], references: [id])
  updatedById      String
  updatedBy        User         @relation("ConfigUpdatedBy", fields: [updatedById], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  offers           CustomerOffer[]
  derivedModels    MirrorModel[]

  @@index([status])
  @@index([updatedAt])
  @@index([name])
  @@index([code])
}

/// Customer commercial offer. Issued prices live in OfferRevision snapshots — never mutate after issue.
model CustomerOffer {
  id                   String             @id @default(cuid())
  /// Human-readable unique number, e.g. OFT-2026-0001
  number               String             @unique
  status               OfferStatus        @default(DRAFT)
  configurationId      String?
  configuration        SavedConfiguration? @relation(fields: [configurationId], references: [id])
  /// Optional link to a commercial catalog model (Stage 6.1+). Issued prices stay in revisions.
  mirrorModelId        String?
  mirrorModel          MirrorModel?        @relation(fields: [mirrorModelId], references: [id])
  clientName           String
  clientPhone          String
  clientEmail          String?
  clientCompany        String?
  clientNotes          String?
  /// Optional link to the customer registry. Offer name and phone stay on this row.
  customerId           String?
  customer             Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  productName          String
  quantity             Int                @default(1)
  /// wholesale | retail — customer never sees sinecost
  priceTier            String             @default("retail")
  validityDays         Int                @default(14)
  validUntil           DateTime?
  commercialNotes      String?
  /// Working draft payload (editable until first issue / between revisions as draft work).
  draftConfigJson      Json?
  draftCalculationJson Json?
  issuedAt             DateTime?
  createdById          String
  createdBy            User               @relation("OfferCreatedBy", fields: [createdById], references: [id])
  updatedById          String
  updatedBy            User               @relation("OfferUpdatedBy", fields: [updatedById], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  revisions            OfferRevision[]

  @@index([status])
  @@index([issuedAt])
  @@index([number])
  @@index([customerId])
}

/// Immutable commercial snapshot for an issued offer revision.
model OfferRevision {
  id                    String        @id @default(cuid())
  offerId               String
  offer                 CustomerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  revisionNumber        Int
  /// Full immutable commercial + technical snapshot used for PDF and history.
  snapshotJson          Json
  unitPrice             Decimal       @db.Decimal(12, 2)
  servicesTotal         Decimal       @db.Decimal(12, 2)
  offerTotal            Decimal       @db.Decimal(12, 2)
  priceTier             String
  /// Config at issuance (structured).
  configJson            Json
  /// Customer-safe calculation excerpt (no sinecost / internal costs).
  calculationPublicJson Json
  issuedAt              DateTime      @default(now())
  issuedById            String
  issuedBy              User          @relation("RevisionIssuedBy", fields: [issuedById], references: [id])
  notes                 String?

  @@unique([offerId, revisionNumber])
  @@index([offerId, issuedAt])
}

/// Company legal / commercial identity for offer PDFs (ADMIN). Missing fields block issue.
model CompanySettings {
  id          String   @id @default("default")
  legalName   String?
  taxId       String?
  address     String?
  phone       String?
  email       String?
  bankDetails String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Commercial lifecycle for catalog mirror models (not the same as calculation completeness).
enum MirrorModelStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Commercial product categories (distinct from Stage 3 material categories).
model MirrorModelCategory {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String?
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdById String?
  createdBy   User?         @relation("MirrorCategoryCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  models      MirrorModel[]

  @@index([isActive, sortOrder])
}

/// Commercial mirror model — predefined product priced via the central configurator engine.
/// Not a client saved configuration. Soft-archive only; never hard-delete commercial history.
model MirrorModel {
  id                String            @id @default(cuid())
  /// Human-readable unique code, e.g. MOD-2026-0001
  code              String            @unique
  name              String
  /// Unique public URL slug (future shop). Validated unique on write.
  slug              String            @unique
  /// After a manual edit, name changes must not rewrite the slug.
  slugCustomized    Boolean           @default(false)
  shortDescription  String?
  /// Plain-text fallback of the Romanian description, kept for search and preview.
  fullDescription   String?
  /// Sanitized Romanian rich text. Not raw HTML. Russian overlays are not stored yet.
  descriptionJson   Json?
  highlightsJson    Json?
  careJson          Json?
  warrantyJson      Json?
  deliveryJson      Json?
  /// Extra descriptive specs. They never enter the pricing engine.
  extraSpecsJson    Json?
  seoTitle          String?
  seoDescription    String?
  categoryId        String
  category          MirrorModelCategory @relation(fields: [categoryId], references: [id])
  status            MirrorModelStatus @default(DRAFT)
  /// Future public-site publish flag — independent of ACTIVE commercial status.
  isPublished       Boolean           @default(false)
  /// Full ConfiguratorState (shape, LED, processing, commercial).
  configJson        Json
  /// Last central-engine calculation (may be incomplete).
  calculationJson   Json?
  /// Calculation completeness (reuses ConfigStatus semantics).
  calcStatus        ConfigStatus      @default(DRAFT)
  shapeId           String
  shapeLabel        String
  glassTypeId       String
  defaultWidthMm    Decimal           @db.Decimal(12, 2)
  defaultHeightMm   Decimal           @db.Decimal(12, 2)
  /// Stage 6.2 commercial dimension limits (optional; not global mandatory).
  minWidthMm        Decimal?          @db.Decimal(12, 2)
  maxWidthMm        Decimal?          @db.Decimal(12, 2)
  minHeightMm       Decimal?          @db.Decimal(12, 2)
  maxHeightMm       Decimal?          @db.Decimal(12, 2)
  stepWidthMm       Decimal?          @db.Decimal(12, 2)
  stepHeightMm      Decimal?          @db.Decimal(12, 2)
  /// Versioned customer configurator rules (FIXED/EDITABLE/HIDDEN + allowed values).
  /// Null / missing → safe defaults: all FIXED (no public options auto-enabled).
  configuratorRulesJson Json?
  rulesVersion      Int               @default(1)
  sinecost          Decimal?          @db.Decimal(12, 2)
  wholesalePrice    Decimal?          @db.Decimal(12, 2)
  retailPrice       Decimal?          @db.Decimal(12, 2)
  /// Optional origin: created from a professional saved configuration.
  sourceConfigurationId String?
  sourceConfiguration   SavedConfiguration? @relation(fields: [sourceConfigurationId], references: [id])
  createdById       String
  createdBy         User              @relation("MirrorModelCreatedBy", fields: [createdById], references: [id])
  updatedById       String
  updatedBy         User              @relation("MirrorModelUpdatedBy", fields: [updatedById], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  offers            CustomerOffer[]
  orders            CustomerOrder[]
  orderLines        CustomerOrderLine[]
  images            MirrorModelImage[]
  slugRedirects     MirrorModelSlugRedirect[]

  @@index([status])
  @@index([categoryId])
  @@index([updatedAt])
  @@index([name])
  @@index([slug])
  @@index([isPublished])
}

/// Previous public slug of a published model. The future shop can answer 301 to the current slug.
model MirrorModelSlugRedirect {
  id        String      @id @default(cuid())
  modelId   String
  model     MirrorModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  slug      String      @unique
  createdAt DateTime    @default(now())

  @@index([modelId])
}

/// Product photo for a commercial mirror model. Bytes live in object storage, not in Postgres.
model MirrorModelImage {
  id           String          @id @default(cuid())
  modelId      String
  model        MirrorModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  kind         MirrorImageKind @default(SECONDARY)
  isPrimary    Boolean         @default(false)
  sortOrder    Int             @default(0)
  altText      String          @default("")
  /// Internal description. Not exposed on the customer preview.
  internalNote String          @default("")
  /// Relative POSIX key `models/{modelId}/{imageId}`. Never an absolute filesystem path.
  storageKey   String
  originalName String
  mimeType     String
  widthPx      Int
  heightPx     Int
  byteSize     Int
  uploadedById String
  uploadedBy   User            @relation("MirrorImageUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime        @default(now())

  @@index([modelId, sortOrder])
  @@index([modelId, isPrimary])
  @@index([storageKey])
}

/// Categories for materials, components, and operations (e.g. Manoperă).
model MaterialCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  materials Material[]
}

model Material {
  id            String           @id @default(cuid())
  name          String
  /// Optional internal SKU/code; unique when present.
  internalCode  String?          @unique
  /// Stable seed key for idempotent seeds (not shown as business field).
  seedKey       String?          @unique
  categoryId    String
  category      MaterialCategory @relation(fields: [categoryId], references: [id])
  /// Unit price in MDL. Null means unset — never treat as 0.
  unitPrice     Decimal?         @db.Decimal(12, 2)
  unitOfMeasure String
  currency      String           @default("MDL")
  description   String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  priceHistory  MaterialPriceHistory[]

  @@index([categoryId])
  @@index([isActive])
  @@index([name])
}

/// Immutable price change log. No updates/deletes from the application UI.
model MaterialPriceHistory {
  id            String    @id @default(cuid())
  materialId    String
  material      Material  @relation(fields: [materialId], references: [id])
  previousPrice Decimal?  @db.Decimal(12, 2)
  newPrice      Decimal?  @db.Decimal(12, 2)
  changedAt     DateTime  @default(now())
  changedById   String
  changedBy     User      @relation(fields: [changedById], references: [id])

  @@index([materialId, changedAt])
}

/// Singleton global pricing rules (markups, curved-edge add, sandblast minimum).
/// Material unit prices stay on Material — this is not a second price catalog.
model PricingSettings {
  id                     String   @id @default("default")
  wholesaleMarkupPercent Decimal  @default(30) @db.Decimal(8, 2)
  retailMarkupPercent    Decimal  @default(70) @db.Decimal(8, 2)
  /// Standard mm added per curved outer edge direction when admin enables that side.
  curvedEdgeAddMm        Decimal  @default(50) @db.Decimal(8, 2)
  /// Minimum charge per decorative sandblast operation (not per band).
  sandblastMinCharge     Decimal  @default(100) @db.Decimal(12, 2)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

/// Immutable log of global pricing-rule changes.
model PricingSettingsHistory {
  id            String   @id @default(cuid())
  fieldKey      String
  previousValue String?
  newValue      String?
  changedAt     DateTime @default(now())
  changedById   String
  changedBy     User     @relation(fields: [changedById], references: [id])

  @@index([changedAt])
  @@index([fieldKey])
}

enum CustomerKind {
  INDIVIDUAL
  COMPANY
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

/// Customer registry. Offer snapshots keep their own client fields.
/// Orders may be linked here manually. Placing an order does not create a customer.
model Customer {
  id           String         @id @default(cuid())
  /// Human-readable unique code, e.g. CLT-2026-0001
  code         String         @unique
  kind         CustomerKind
  status       CustomerStatus @default(ACTIVE)
  displayName  String
  phone        String
  /// Digits used only to find possible duplicates. Not a second contact record.
  phoneKey     String
  email        String?
  emailKey     String?
  companyName  String?
  idno         String?
  idnoKey      String?
  contactName  String?
  /// Staff-only notes. Never copied onto offers.
  notes        String?
  createdById  String
  createdBy    User           @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedById  String
  updatedBy    User           @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  addresses    CustomerAddress[]
  offers       CustomerOffer[]
  orders       CustomerOrder[]

  @@index([phoneKey])
  @@index([emailKey])
  @@index([idnoKey])
  @@index([status, updatedAt])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  line       String
  city       String?
  postalCode String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_PRODUCTION
  READY
  DELIVERED
  COMPLETED
  CANCELLED
}

/// Customer order. Contact fields and the priced configuration are a snapshot.
/// Linking customerId does not copy or rewrite those fields.
model CustomerOrder {
  id              String       @id @default(cuid())
  /// Human-readable unique number, e.g. CMD-2026-0001
  number          String       @unique
  status          OrderStatus  @default(NEW)
  customerName    String
  customerPhone   String
  /// Digits used only for search. Not a registry record.
  phoneKey        String
  deliveryAddress String
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  mirrorModelId   String?
  mirrorModel     MirrorModel? @relation(fields: [mirrorModelId], references: [id], onDelete: SetNull)
  modelCode       String
  modelName       String
  /// Validated configurator state at placement. Never repriced later.
  configJson      Json
  /// Human configuration summary frozen at placement.
  summaryJson     Json
  retailPrice     Decimal      @db.Decimal(12, 2)
  currency        String       @default("MDL")
  advanceAmount   Decimal      @default(0) @db.Decimal(12, 2)
  quantity        Int          @default(1)
  /// Stops a repeated checkout from creating a second order.
  idempotencyKey  String?      @unique
  placedById      String?
  placedBy        User?        @relation("OrderPlacedBy", fields: [placedById], references: [id])
  placedAt        DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  statusEvents    OrderStatusEvent[]
  lines           CustomerOrderLine[]

  @@index([status, placedAt])
  @@index([phoneKey])
  @@index([customerId])
}

/// One configured mirror inside an order. Prices are frozen at placement.
model CustomerOrderLine {
  id            String        @id @default(cuid())
  orderId       String
  order         CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sortOrder     Int
  mirrorModelId String?
  mirrorModel   MirrorModel?  @relation(fields: [mirrorModelId], references: [id], onDelete: SetNull)
  modelCode     String
  modelName     String
  imageId       String?
  configJson    Json
  summaryJson   Json
  unitPrice     Decimal       @db.Decimal(12, 2)
  quantity      Int
  lineTotal     Decimal       @db.Decimal(12, 2)

  @@index([orderId, sortOrder])
}

/// Last issued suffix for CFG, OFT, MOD, CLT and CMD numbers.
/// Allocation is serialized so two requests cannot receive the same code.
model NumberSequence {
  name String @id
  last Int
}

model OrderStatusEvent {
  id          String        @id @default(cuid())
  orderId     String
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?
  changedBy   User?         @relation("OrderStatusChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([orderId, createdAt])
}
