# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/zera?schema=public"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
# On Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
AUTH_SECRET="replace-with-a-long-random-string"

# Optional public app URL (useful in production)
# AUTH_URL="http://localhost:3000"

# Optional local directory for product photos (relative to the app). Default: storage/media
# ZERA_MEDIA_DIR="storage/media"

# Bootstrap admin user (required for prisma db seed)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-strong-password"
SEED_ADMIN_NAME="Administrator"

# Optional bootstrap manager user
# SEED_MANAGER_EMAIL="manager@example.com"
# SEED_MANAGER_PASSWORD="change-me-strong-password"
# SEED_MANAGER_NAME="Manager"
